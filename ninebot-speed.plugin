#!name = Ninebot Speed Restore
#!desc = Restore speed display in Ninebot app ride track. Stage 1 captures API responses, Stage 2 computes GPS-based speed and injects it. Display-only, no vehicle behavior change.
#!author = JwOKR
#!date = 2026-10-29

[MITM]
hostname = cn-cbu-gateway.ninebot.com

[Script]
http-response ^https?:\/\/cn-cbu-gateway\.ninebot\.com\/ script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@7e4436d/ninebot-debug.js,tag=nb-capture,requires-body=true,enable=true,timeout=60
http-response ^https?:\/\/cn-cbu-gateway\.ninebot\.com\/(app-api|portal)\/ script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@7e4436d/ninebot-speed.js,tag=nb-inject,requires-body=true,enable=true,timeout=60
