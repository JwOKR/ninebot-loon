#!name = Ninebot Speed Restore
#!desc = Restore speed display in Ninebot app ride track. Stage 1 captures API responses, Stage 2 computes GPS-based speed and injects it. Display-only, no vehicle behavior change.
#!author = JwOKR
#!date = 2026-10-29

[MITM]
hostname = cn-cbu-gateway.ninebot.com

[Script]
capture = type=http-response,pattern=^https?:\/\/cn-cbu-gateway\.ninebot\.com\/portal\/api\/(ride|track|trail|trip|trajectory|driv|run|mileage|travel|behav|gps|journey|sport),requires-body=true,script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@main/ninebot-debug.js,timeout=60
inject = type=http-response,pattern=^https?:\/\/cn-cbu-gateway\.ninebot\.com\/portal\/api\/(ride|track|trail|trip|trajectory|driv|run|mileage|travel|behav|gps|journey|sport),requires-body=true,script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@main/ninebot-speed.js,timeout=60
