#!name = 九号配置扫描 v3
#!desc = 嗅探 ninebot 全部请求（修正状态码 + 降噪），确认 iOS 是否下发仪表配置文件
#!author = JwOKR
#!date = 2026-10-30

[MITM]
hostname = *.ninebot.com, *.ninebot.cn, *.segwaydiscovery.com, oms-oss-public.ninebot.com, oms-oss-public-test.ninebot.com, cnnx-omsgw.ninebot.com

[Script]
http-response ^https?:\/\/[^\/]*(?:ninebot|segway) script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@7ef2b563725da7ce51913f255260d0ca311e3fcc/dash-all.js,tag=nb-dash-all,requires-body=true,enable=true
http-response ^https?:\/\/[^\/]*(?:ninebot|segway) script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@78b33f042ce27e771e90776fb9e00bd735a8ea89/dash-swap.js,tag=nb-dash-swap,requires-body=true,enable=true
