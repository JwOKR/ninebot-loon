#!name = 九号配置扫描 v2
#!desc = 全量嗅探 ninebot 域名的每一次请求，找出 iOS 端仪表配置 / 签名的真实下载地址
#!author = JwOKR
#!date = 2026-10-30

[MITM]
hostname = *.ninebot.com, *.ninebot.cn, *.segwaydiscovery.com, oms-oss-public.ninebot.com, oms-oss-public-test.ninebot.com, cnnx-omsgw.ninebot.com

[Script]
http-response ^https?:\/\/[^\/]*(?:ninebot|segway) script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@<SHA>/dash-all.js,tag=nb-dash-all,requires-body=true,enable=true
http-response ^https?:\/\/[^\/]*(?:ninebot|segway) script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@<SHA>/dash-scan.js,tag=nb-dash-scan,requires-body=true,enable=true
