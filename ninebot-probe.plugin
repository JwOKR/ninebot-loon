[MITM]
hostname = cnnx-omsgw.ninebot.com

[Script]
http-request ^https?:\/\/cnnx-omsgw\.ninebot\.com\/app-api\/travel script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@8fe4c0f/probe-spoof.js,requires-body=true,tag=nb-spoof,enable=true
http-response ^https?:\/\/cnnx-omsgw\.ninebot\.com\/app-api\/travel script-path=https://cdn.jsdelivr.net/gh/JwOKR/ninebot-loon@8fe4c0f/probe-size.js,requires-body=true,tag=nb-size,enable=true
